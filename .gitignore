# Tools run with dotnet (outside Unity). *.csproj is ignored above (Unity regenerates its own),
# so every Tools project is whitelisted here explicitly.
!/Tools/CoreTests/CoreTests.csproj
!/Tools/Sim/*.csproj
!/Tools/UnityCheck/UnityCheck.csproj
!/Tools/EditorCheck/EditorCheck.csproj
/Tools/*/bin/
/Tools/*/obj/
