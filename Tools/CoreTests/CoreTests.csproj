<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the Unity EditMode tests for the pure game logic outside Unity:
      dotnet test Tools/CoreTests
    The same .cs files are compiled by Unity through the asmdefs in Assets/SplashSort.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/SplashSort/Scripts/Core/**/*.cs" />
    <Compile Include="../../Assets/SplashSort/Tests/Editor/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
