<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the pure game logic, run outside Unity:
      dotnet test Tools/CoreTests
    The balance guard (BalanceTests, category Balance) runs by default; SKIP_BALANCE=1 skips it.
    The tests live here, outside Assets, so Unity never compiles them (it would need the Test Framework package).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Titan/Scripts/Core/**/*.cs" />
    <Compile Include="*.cs" />
    <!-- The simulator bots and runner, shared with Tools/Sim for BalanceTests (Program.cs stays out). -->
    <Compile Include="../Sim/Bots.cs;../Sim/SimRunner.cs;../Sim/SimReport.cs;../Sim/Presets.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
